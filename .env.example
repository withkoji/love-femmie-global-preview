# Copy to .env for local development; never commit real credentials.
STRIPE_SECRET_KEY=replace_with_restricted_test_key
DOMAIN=http://localhost:4242
PORT=4242
# Stripe webhook signing secret required before activating memberships:
STRIPE_WEBHOOK_SECRET=replace_with_webhook_signing_secret
STRIPE_PRICE_ESSENTIAL=price_replace_essential
STRIPE_PRICE_PLUS=price_replace_plus
STRIPE_PRICE_ELITE=price_replace_elite
